# ====================================================
# ShapeTeam Backend — Environment Configuration
# ====================================================

PORT=5001
FRONTEND_URL="http://localhost:3001"

# Database Configuration (supports PostgreSQL or lightweight JSON store)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shapeteam?schema=public"
USE_MOCK_DB=true

# Cache Configuration (supports Redis or in-memory cache)
REDIS_URL="redis://localhost:6379"
USE_MOCK_CACHE=true

# Python ML Microservice (Optional)
ML_SERVICE_URL="http://localhost:8000"

# Clerk Secret Key (Get from Clerk Dashboard > API Keys)
CLERK_SECRET_KEY=sk_test_your_secret_key_here
